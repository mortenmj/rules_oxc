load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_rust//rust:defs.bzl", "rust_binary")

rust_binary(
    name = "transpiler",
    srcs = ["transpiler.rs"],
    deps = [
        "@crates//:oxc",
    ],
)

package(default_visibility = ["//visibility:public"])

bzl_library(
    name = "dts_transpiler",
    srcs = ["dts_transpiler.bzl"],
    deps = [
        "@aspect_rules_js//js:providers",
        ":util",
    ],
)

bzl_library(
    name = "js_transpiler",
    srcs = ["js_transpiler.bzl"],
    deps = [
        "@aspect_rules_js//js:providers",
        ":util",
    ],
)

bzl_library(
    name = "resolved_toolchain",
    srcs = ["resolved_toolchain.bzl"],
)

bzl_library(
    name = "toolchains_repo",
    srcs = ["toolchains_repo.bzl"],
)

bzl_library(
    name = "util",
    srcs = ["util.bzl"],
)

bzl_library(
    name = "versions",
    srcs = ["versions.bzl"],
)
